# syntax=docker/dockerfile:1
#
# Image de BASE de Basketland : système, ffmpeg, Ollama et les environnements
# Python des moteurs d'IA (plusieurs Go). Elle ne change presque jamais : la
# CI ne la reconstruit que si ce fichier change (étiquette = son empreinte).
# L'image de l'application (Dockerfile) part de cette base et n'ajoute que le serveur Rust,
# l'interface et les scripts (~100 Mo) : une mise à jour ne retélécharge
# plus que ces quelques couches, le NAS garde les couches lourdes.
#
# Cible `lite` (image `latest`) : Ollama et Whisper.

# ---------------------------------------------------------------- Ollama
# Traduction des commentaires : binaire Ollama et ses bibliothèques CUDA,
# repris de l'image officielle, version figée. Seules les bibliothèques
# CUDA 12 sont gardées (elles tournent avec tous les pilotes récents) : les
# variantes CUDA 13 (doublon de CUDA 12, 0,9 Go), MLX CUDA 13 (2,9 Go,
# moteur des modèles d'images, inutile ici), ROCm et Vulkan sont retirées.
FROM ollama/ollama:0.40.5 AS ollama-src
FROM debian:bookworm-slim AS ollama
COPY --from=ollama-src /usr/bin/ollama /ollama/bin/ollama
COPY --from=ollama-src /usr/lib/ollama /ollama/lib
RUN find /ollama/lib -mindepth 1 -maxdepth 1 \( -iname 'rocm*' -o -iname 'vulkan*' -o -iname 'cuda_v13*' -o -iname 'mlx*' \) -exec rm -rf {} + \
 && test -d /ollama/lib/cuda_v12 \
 && du -sh /ollama/lib

# ---------------------------------------------------------------- Whisper
# Transcription des commentaires : faster-whisper (CTranslate2) dans un
# environnement Python dédié, avec cuBLAS et cuDNN installés par pip — pas
# besoin d'image CUDA de base, le pilote est fourni par l'hôte (runtime
# NVIDIA). Versions figées : PyAV 18+ casse faster-whisper 1.2.1
# (« open() got an unexpected keyword argument 'metadata_errors' »).
FROM debian:bookworm-slim AS python
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv \
 && rm -rf /var/lib/apt/lists/*

FROM python AS whisper
RUN python3 -m venv /opt/whisper \
 && /opt/whisper/bin/pip install \
      faster-whisper==1.2.1 ctranslate2==4.8.2 av==17.1.0 \
      nvidia-cublas-cu12==12.9.2.10 nvidia-cudnn-cu12==9.26.1.1

# ---------------------------------------------------------------- système commun
# Debian seule (la même glibc et le même Python que les environnements
# /opt/* construits plus haut).
#
# Utilisateur `node` (uid 1000) : le même que dans les anciennes images,
# basées sur l'image `node`, pour que les volumes /data existants (dont les
# fichiers appartiennent à 1000:1000) restent inscriptibles.
#
# ffmpeg : audio des replays et images du bandeau de score. `util-linux` :
# `setpriv` (l'entrypoint lâche les privilèges root). `tini` : PID 1 qui
# récupère les processus enfants terminés (Python, Ollama, ffmpeg) au lieu
# de les laisser en zombies. `libtesseract5` : OCR natif du serveur Rust.
FROM debian:bookworm-slim AS system
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg ca-certificates util-linux python3 libtesseract5 tzdata tini \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 1000 node \
 && useradd --uid 1000 --gid node --create-home --home-dir /home/node --shell /bin/sh node

# ---------------------------------------------------------------- lite
FROM system AS lite
COPY --from=ollama /ollama/bin/ollama /usr/bin/ollama
COPY --from=ollama /ollama/lib /usr/lib/ollama
COPY --from=whisper /opt/whisper /opt/whisper

# Cible par défaut.
FROM lite
